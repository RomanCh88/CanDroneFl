# Copy to .env.local for local development (never commit .env.local).
# Values: Firebase console → Project settings → General → Your apps → Web app → SDK setup (Config).
# The web config is public by design; access is protected by Auth + firestore.rules.
# If these are empty the app runs in public-only mode (no sign-in button).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=candronefly.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=candronefly
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-only (never NEXT_PUBLIC_): invite-only access ---
# In production these come from Cloud Secret Manager (see apphosting.yaml).
ADMIN_EMAIL=
APPROVAL_SECRET=          # node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
EMAIL_FROM=DroneFly <noreply@candronefly.org>
RESEND_API_KEY=
# APP_URL=https://candronefly.org
